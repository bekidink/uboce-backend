NODE_ENV=development
PORT=4100
LOG_LEVEL=info
REDIS_URL=redis://localhost:6380
# Browser origins allowed to call the API (comma-separated). Mobile apps don't need this.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300
# Local value; production should use the default (30).
AUTH_RATE_LIMIT_PER_MINUTE=150
# Set to the number of load balancers in front of the gateway in production.
TRUST_PROXY_HOPS=0

IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103
CATALOG_URL=http://localhost:4104
DISCOVERY_URL=http://localhost:4105
PROCUREMENT_URL=http://localhost:4106
COMMERCE_URL=http://localhost:4107
