# Your Hugging Face Space: create it at huggingface.co/new-space (SDK: Docker, hardware: CPU basic — free).
SPACE_ID=bekidink/uboce
# Optional: defaults to https://<owner>-<name>.hf.space
SPACE_URL=
# Uploaded files: Supabase dashboard → Storage → S3 Connection → "New access key".
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-west-1
# Where the uboce-web repo is (default: next to this repo).
WEB_REPO=
