# Your domains: point each one's DNS A (and AAAA) record at the server first.
API_DOMAIN=api.example.com
FILES_DOMAIN=files.example.com
APP_DOMAIN=app.example.com
# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=admin@example.com
# Where the server pulls images from (built by CI). TAG=latest, or a commit SHA to pin a release.
IMAGE_PREFIX=ghcr.io/bekidink/uboce
TAG=latest
