{
  "name": "uboce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "generate": "pnpm -r --filter \"./services/*\" prisma:generate",
    "migrate": "pnpm -r --workspace-concurrency=1 --filter \"./services/*\" prisma:migrate",
    "build": "pnpm generate && pnpm -r build",
    "dev": "pnpm -r --parallel --filter \"./services/*\" --filter ./apps/gateway start:dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint packages/ services/ apps/",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "smoke": "node scripts/smoke-operations.mjs && node scripts/smoke-test.mjs",
    "infra:db": "docker compose exec -T postgres psql -U postgres -v ON_ERROR_STOP=1 -f /docker-entrypoint-initdb.d/init.sql",
    "migrate:dev": "pnpm -r --filter \"./services/*\" prisma:migrate:dev",
    "compose:generate": "node scripts/generate-compose.mjs",
    "smoke:operations": "node scripts/smoke-operations.mjs",
    "smoke:core": "node scripts/smoke-test.mjs",
    "seed": "node scripts/seed.mjs",
    "db:supabase": "node scripts/supabase-setup.mjs",
    "db:local": "node scripts/supabase-setup.mjs local",
    "render:generate": "node scripts/generate-render.mjs",
    "deploy:secrets": "node scripts/deploy-secrets.mjs",
    "deploy:push-env": "node scripts/render-push-env.mjs",
    "vps:generate": "node scripts/generate-vps.mjs",
    "vps:env": "node scripts/vps-env.mjs",
    "hf:config": "node scripts/hf-config.mjs",
    "hf:push": "node scripts/hf-push.mjs",
    "admin:code": "node scripts/admin-code.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
