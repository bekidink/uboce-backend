NODE_ENV=development
PORT=4121
LOG_LEVEL=info
DATABASE_URL=postgresql://administration_svc:administration_dev@localhost:5433/administration
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=administration
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103

# Become platform_admin on first use once the email is verified (and MFA is on). Comma-separated.
ADMIN_BOOTSTRAP_EMAILS=
REQUIRE_STAFF_MFA=true

# Scheduler (PRD v2 PLT-02): calls each owning service's /internal/jobs
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=15
SCHEDULER_CONCURRENCY=4
SCHEDULER_JOB_TIMEOUT_SECONDS=300
SCHEDULER_ALERT_AFTER_FAILURES=3
CATALOG_URL=http://localhost:4104
DISCOVERY_URL=http://localhost:4105
PROCUREMENT_URL=http://localhost:4106
COMMERCE_URL=http://localhost:4107
INVENTORY_URL=http://localhost:4108
WAREHOUSE_URL=http://localhost:4109
LOGISTICS_URL=http://localhost:4110
QUALITY_URL=http://localhost:4111
AGRICULTURE_URL=http://localhost:4112
MANUFACTURING_URL=http://localhost:4113
KYC_URL=http://localhost:4114
KYB_URL=http://localhost:4115
FINANCE_URL=http://localhost:4116
DOCUMENT_URL=http://localhost:4117
DISPUTE_URL=http://localhost:4118
INTEGRATION_URL=http://localhost:4119
ANALYTICS_URL=http://localhost:4120
