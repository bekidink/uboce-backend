NODE_ENV=development
PORT=4121
LOG_LEVEL=info
DATABASE_URL=postgresql://administration_svc:administration_dev@localhost:5433/administration
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=administration
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103

# Become platform_admin on first use once the email is verified (and MFA is on). Comma-separated.
ADMIN_BOOTSTRAP_EMAILS=
REQUIRE_STAFF_MFA=true
