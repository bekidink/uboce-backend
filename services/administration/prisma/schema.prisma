// Administration Service (S21) — platform staff roles, settings, feature flags
// and audited administrative actions.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  platform_admin
  verification_reviewer
  dispute_reviewer
  support
}

/// Who is platform staff. Rows are never deleted; revocation is recorded.
model PlatformRoleGrant {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  role            PlatformRole
  reason          String
  grantedByUserId String?      @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt       DateTime?    @map("revoked_at") @db.Timestamptz(3)
  revokedByUserId String?      @map("revoked_by_user_id") @db.Uuid
  revokeReason    String?      @map("revoke_reason")

  @@index([userId, revokedAt])
  @@map("platform_role_grants")
}

model Setting {
  key             String   @id
  value           Json
  description     String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

model FeatureFlag {
  key             String   @id
  /// On for everyone…
  enabled         Boolean  @default(false)
  /// …or only for these organizations (pilot rollouts).
  organizationIds String[] @map("organization_ids") @db.Uuid
  description     String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

/// Which optional modules an organization may use (PRD addendum 2.10). No row = the module's default.
model Entitlement {
  organizationId  String    @map("organization_id") @db.Uuid
  moduleKey       String    @map("module_key")
  enabled         Boolean
  /// Trial or subscription end; after it the module falls back to its default.
  validUntil      DateTime? @map("valid_until") @db.Timestamptz(3)
  note            String?
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organizationId, moduleKey])
  @@map("entitlements")
}

/// Which modules a business (organization) type gets by default; drives every such organization's sidebar.
model BusinessTypeModule {
  organizationType String   @map("organization_type")
  moduleKey        String   @map("module_key")
  enabled          Boolean
  updatedByUserId  String?  @map("updated_by_user_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([organizationType, moduleKey])
  @@map("business_type_modules")
}

/// Append-only record of every administrative action (PRD 5.21, 9).
model AuditEntry {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  reasonCode  String   @map("reason_code")
  reason      String
  /// Before/after values for settings and flags.
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_entries")
}

/// Transactional outbox (PRD 8.3).
model OutboxEvent {
  id          String    @id @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

// ---- Scheduler (PRD v2 PLT-02, PLT-03) ------------------------------------------------------

/// One scheduled job: which service owns it, how often it runs, and its last outcome.
model JobDefinition {
  /// "<service>:<job>", e.g. commerce:orders.expire-unconfirmed
  name                String    @id
  service             String
  job                 String
  description         String
  intervalSeconds     Int       @map("interval_seconds")
  timeoutSeconds      Int       @default(120) @map("timeout_seconds")
  enabled             Boolean   @default(true)
  nextRunAt           DateTime  @map("next_run_at") @db.Timestamptz(3)
  /// The claim: only the instance holding an unexpired lock runs the job.
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lockedBy            String?   @map("locked_by")
  lastRunAt           DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastStatus          String?   @map("last_status")
  lastError           String?   @map("last_error")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  alertedAt           DateTime? @map("alerted_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs JobRun[]

  @@index([enabled, nextRunAt])
  @@map("job_definitions")
}

enum JobRunStatus {
  running
  succeeded
  failed
  skipped
  abandoned
}

model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  jobName    String       @map("job_name")
  instance   String
  status     JobRunStatus @default(running)
  processed  Int?
  detail     Json?
  error      String?
  startedAt  DateTime     @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(3)
  durationMs Int?         @map("duration_ms")

  definition JobDefinition @relation(fields: [jobName], references: [name], onDelete: Cascade)

  @@index([jobName, startedAt])
  @@index([startedAt])
  @@map("job_runs")
}
