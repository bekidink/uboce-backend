NODE_ENV=development
PORT=4117
LOG_LEVEL=info
DATABASE_URL=postgresql://document_svc:document_dev@localhost:5433/document
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=document
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103

# Private S3-compatible storage (SeaweedFS locally; any S3 in production).
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=uboce-documents
S3_ACCESS_KEY=uboce_dev
S3_SECRET_KEY=uboce_dev_secret_key
MAX_UPLOAD_BYTES=10485760
LINK_TTL_SECONDS=300
ADMINISTRATION_URL=http://localhost:4121
