// Document Service (S17) — private file metadata, upload/download grants, retention and audit.
// File bytes live in private S3-compatible storage; nothing here is ever publicly addressable.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentClassification {
  identity_document
  business_registration
  license
  tax_certificate
  delivery_evidence
  inspection_evidence
  dispute_evidence
  invoice
  product_image
  other
}

enum DocumentStatus {
  pending_upload
  available
  rejected
  deleted
}

enum GranteeType {
  organization
  user
  /// A review case (KYC/KYB/dispute): readable by staff with the matching role.
  case
}

model Document {
  id                  String                 @id @default(uuid()) @db.Uuid
  ownerUserId         String                 @map("owner_user_id") @db.Uuid
  ownerOrganizationId String?                @map("owner_organization_id") @db.Uuid
  classification      DocumentClassification
  fileName            String                 @map("file_name")
  contentType         String                 @map("content_type")
  declaredSize        Int                    @map("declared_size")
  sizeBytes           Int?                   @map("size_bytes")
  sha256              String?
  storageKey          String                 @unique @map("storage_key")
  status              DocumentStatus         @default(pending_upload)
  rejectionReason     String?                @map("rejection_reason")
  retentionUntil      DateTime?              @map("retention_until") @db.Timestamptz(3)
  legalHold           Boolean                @default(false) @map("legal_hold")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt          DateTime?              @map("uploaded_at") @db.Timestamptz(3)
  deletedAt           DateTime?              @map("deleted_at") @db.Timestamptz(3)

  grants    DocumentGrant[]
  accessLog DocumentAccessLog[]

  @@index([ownerOrganizationId, classification])
  @@index([ownerUserId])
  @@map("documents")
}

model DocumentGrant {
  id          String      @id @default(uuid()) @db.Uuid
  documentId  String      @map("document_id") @db.Uuid
  granteeType GranteeType @map("grantee_type")
  granteeId   String      @map("grantee_id")
  reason      String
  grantedBy   String      @map("granted_by")
  expiresAt   DateTime?   @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, granteeType, granteeId])
  @@map("document_grants")
}

/// Every upload and download link issued, and every grant (PRD 5.17: audit sensitive access).
model DocumentAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  action      String
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorService String? @map("actor_service")
  organizationId String? @map("organization_id") @db.Uuid
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_access_log")
}

/// Transactional outbox (PRD 8.3).
model OutboxEvent {
  id          String    @id @db.Uuid
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}
