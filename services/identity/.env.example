NODE_ENV=development
PORT=4101
LOG_LEVEL=info
DATABASE_URL=postgresql://identity_svc:identity_dev@localhost:5433/identity
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=identity
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SERVICE_TOKEN_TTL_SECONDS=300
# Per IP, per auth endpoint. Local value; production should use the default (10).
AUTH_RATE_LIMIT_PER_MINUTE=60
APP_BASE_URL=http://localhost:4200
# `pnpm setup` generates these.
JWT_PRIVATE_KEY=
MFA_ENCRYPTION_KEY=
SERVICE_CLIENTS=
