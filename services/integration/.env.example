NODE_ENV=development
PORT=4119
LOG_LEVEL=info
DATABASE_URL=postgresql://integration_svc:integration_dev@localhost:5433/integration
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=integration
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103
FINANCE_URL=http://localhost:4116
LOGISTICS_URL=http://localhost:4110
# Webhook providers: name:kind:secret (kind = payment | carrier). `pnpm setup` adds test providers locally.
PROVIDERS=
CALLBACK_MAX_AGE_SECONDS=300
ADMINISTRATION_URL=http://localhost:4121
