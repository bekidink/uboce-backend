NODE_ENV=development
PORT=4110
LOG_LEVEL=info
DATABASE_URL=postgresql://logistics_svc:logistics_dev@localhost:5433/logistics
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=logistics
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103
COMMERCE_URL=http://localhost:4107
INVENTORY_URL=http://localhost:4108
WAREHOUSE_URL=http://localhost:4109
DOCUMENT_URL=http://localhost:4117
