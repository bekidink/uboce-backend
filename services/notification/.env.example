NODE_ENV=development
PORT=4103
LOG_LEVEL=info
DATABASE_URL=postgresql://notification_svc:notification_dev@localhost:5433/notification
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=notification
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103

# Mailpit locally (inbox at http://localhost:8025). Leave empty to log emails instead.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=UBOCE <no-reply@uboce.local>
# Firebase service account JSON (keep outside git, e.g. ../../secrets/). Empty = log pushes.
FIREBASE_SERVICE_ACCOUNT_PATH=
