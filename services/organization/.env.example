NODE_ENV=development
PORT=4102
LOG_LEVEL=info
DATABASE_URL=postgresql://organization_svc:organization_dev@localhost:5433/organization
REDIS_URL=redis://localhost:6380

JWT_ISSUER=uboce-identity
JWT_AUDIENCE=uboce
# Identity's public key (base64 PEM). `pnpm setup` fills it in.
JWT_PUBLIC_KEY=

# Service-to-service credentials. `pnpm setup` generates the secret.
SERVICE_CLIENT_ID=organization
SERVICE_CLIENT_SECRET=
IDENTITY_URL=http://localhost:4101
ORGANIZATION_URL=http://localhost:4102
NOTIFICATION_URL=http://localhost:4103

APP_BASE_URL=http://localhost:3000
INVITATION_TTL_DAYS=7
